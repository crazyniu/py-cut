{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pycut",
  "version": "0.1.0",
  "identifier": "com.pycut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"pycut","width":1440,"height":900,"minWidth":1280,"minHeight":800}],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {"enable": true,"scope": []}
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {"resources/": "resources/"},
    "macOS": {"minimumSystemVersion": "13.0"},
    "windows": {"nsis": {"displayLanguageSelector": false}}
  }
}
