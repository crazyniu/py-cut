# 复制本文件为 .env 后填写（.env 已被 git 忽略，不会提交）
#   cp .env.example .env
#
# 网关只有两个：主网关 main / 备用网关 backup（与厂商无关）。
# 默认主网关就是 DeepSeek，想换任意 OpenAI 兼容网关，改下面三项即可。

# ---------------- 主网关（必填）----------------
# 网关地址（OpenAI 兼容，结尾不要带 /chat/completions）
PYCUT_MAIN_URL=https://api.deepseek.com/v1
# 密钥（必填）
PYCUT_MAIN_KEY=sk-你的密钥
# 模型名称
PYCUT_MAIN_MODEL=deepseek-flash

# ---------------- 备用网关（可选）----------------
# 主网关连续失败 3 次会自动切换过来；不填则不启用自动切换。
# 命令行 --gateway backup 可直接用备用网关起步，--no-fallback 可关闭自动切换。
# PYCUT_BACKUP_URL=https://api.other.com/v1
# PYCUT_BACKUP_KEY=sk-xxxxxxxx
# PYCUT_BACKUP_MODEL=some-model
