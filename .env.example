# Copy to ignored .env and configure local material/gateway values.
# cp .env.example .env
# Environment variables override this file. Never commit actual credentials.

# OpenAI-compatible main gateway; omit /chat/completions from the base URL.
PYCUT_MAIN_URL=https://api.deepseek.com/v1
PYCUT_MAIN_KEY=sk-你的密钥
PYCUT_MAIN_MODEL=deepseek-flash

# Optional backup: sticky failover after three consecutive main failures.
# --gateway backup selects it explicitly; --no-fallback disables automatic switching.
# PYCUT_BACKUP_URL=https://api.other.com/v1
# PYCUT_BACKUP_KEY=sk-xxxxxxxx
# PYCUT_BACKUP_MODEL=some-model

# Relative paths resolve against the project; input roots must exist.
# Copy the settings URL shown in the TUI into a browser manually.
# Original videos for tail-only Douyin fission; independent of montage libraries.
PYCUT_SOURCE_DIR=
# Reference subfolders each contain one video and same-stem SRT.
PYCUT_REFERENCE_DIR=
# User-supplied background clips; single paths and JSON path arrays are supported.
# Example: PYCUT_CLIP_DIR='["/media/clips-a","/media/clips-b"]'
PYCUT_CLIP_DIR=
# Optional recursive PIP/intro roots; absent/disabled pools are skipped.
PYCUT_PIP_DIR=
PYCUT_INTRO_DIR=
PYCUT_OUTPUT_DIR=output
# Optional local stickers; empty uses online defaults.
PYCUT_STICKER_DIR=
