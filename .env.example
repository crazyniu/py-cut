# 复制本文件为 .env 后填写（.env 已被 git 忽略，不会提交）
#   cp .env.example .env

# ---------------- 必填：DeepSeek 密钥 ----------------
DEEPSEEK_API_KEY=sk-你的密钥

# ---------------- 可选：网关地址 / 模型 / 默认网关 ----------------
# 默认就是 DeepSeek，下面三项通常不用改；想换 OpenAI 兼容网关时再配。

# 网关地址（OpenAI 兼容，结尾不要带 /chat/completions）
PYCUT_LLM_URL=https://api.deepseek.com/v1

# 模型名称
PYCUT_LLM_MODEL=deepseek-flash

# 默认网关：deepseek 或 local（命令行 --gateway 仍可覆盖）
PYCUT_GATEWAY=deepseek

# ---------------- 可选：局域网备用网关 local ----------------
# 只有 PYCUT_GATEWAY=local 或命令行 --gateway local 时才用到
# PYCUT_LOCAL_URL=http://192.168.1.250:20128/v1
# PYCUT_LOCAL_KEY=sk-xxxxxxxx
# PYCUT_LOCAL_MODEL=deepseek-v4.1-flash
